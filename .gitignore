# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

/node_modules
**/node_modules/
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/
functions/lib/
functions/node_modules/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# build and lint logs
*.txt
*.log
.eslint-errors.json
*.tsbuildinfo
*.bak

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# firebase
.firebase/
firebase-debug.log*

# legacy and diagnostic files
/App.tsx
/index.html
/index.tsx
/vite.config.ts
/upgrade_ui.js
/metadata.json
/sites.json
/build_err*
/build_log*
/lint_output*
/tsc_output*
